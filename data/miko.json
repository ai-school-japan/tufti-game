{
  "welcome": [
    { "text": "うふふ…また来たのね。",                       "voice": "welcome_01.wav" },
    { "text": "待っていたわ。",                               "voice": "welcome_02.wav" },
    { "text": "今日はどんな未来を選ぶの？",                   "voice": "welcome_03.wav" },
    { "text": "あなたが来ると思っていた。",                   "voice": "welcome_04.wav" },
    { "text": "世界線があなたを呼んでいるわ。",               "voice": "welcome_05.wav" },
    { "text": "今日の選択が現実を変える…かもしれないわ。",   "voice": "welcome_06.wav" },
    { "text": "うふふっ！",                                   "voice": "welcome_07.wav" },
    { "text": "ねー！！",                                     "voice": "welcome_08.wav" },
    { "text": "私の愛しいカタツムリちゃん！",                 "voice": "welcome_09.wav" }
  ],
  "login": [
    { "text": "今日も世界線を選ぶのよ。",                     "voice": "login_01.wav" },
    { "text": "昨日とは違う未来になるかもしれないわ。",       "voice": "login_02.wav" },
    { "text": "今日はどんな日にする？",                       "voice": "login_03.wav" },
    { "text": "あなたが選ぶ未来を見守っているわ。",           "voice": "login_04.wav" },
    { "text": "毎日来てくれて…嬉しいわ。",                   "voice": "login_05.wav" }
  ],
  "worldSelect": [
    { "text": "どの世界線に進む？",                           "voice": "worldSelect_01.wav" },
    { "text": "心が惹かれる世界線を選んで。",                 "voice": "worldSelect_02.wav" },
    { "text": "直感で選ぶのが正解よ。",                       "voice": "worldSelect_03.wav" },
    { "text": "あなたの魂が向かう先はどこ？",                 "voice": "worldSelect_04.wav" },
    { "text": "世界線は無限にある…今日はどこへ？",           "voice": "worldSelect_05.wav" }
  ],
  "choice": [
    { "text": "その選択も悪くないわ。",                       "voice": "choice_01.wav" },
    { "text": "面白い選択ね。",                               "voice": "choice_02.wav" },
    { "text": "あなたの直感を信じて。",                       "voice": "choice_03.wav" },
    { "text": "どちらも、あなたの未来よ。",                   "voice": "choice_04.wav" },
    { "text": "心が動く方へ進んで。",                         "voice": "choice_05.wav" },
    { "text": "良い選択ね…宇宙も喜んでいるわ。",             "voice": "choice_06.wav" },
    { "text": "その選択が現実を動かすのよ。",                 "voice": "choice_07.wav" },
    { "text": "迷ったとき、心の声に従うのが正解よ。",         "voice": "choice_08.wav" }
  ],
  "reward": [
    { "text": "報酬を得たわ。",                               "voice": "reward_01.wav" },
    { "text": "素敵な結果ね。",                               "voice": "reward_02.wav" },
    { "text": "現実が動き始めているわ。",                     "voice": "reward_03.wav" },
    { "text": "あなたの選択が実を結んだのね。",               "voice": "reward_04.wav" },
    { "text": "この流れを続けて。",                           "voice": "reward_05.wav" },
    { "text": "宇宙があなたに微笑んでいるわ。",               "voice": "reward_06.wav" }
  ],
  "mission": [
    { "text": "新たなミッションが始まるわ。",                 "voice": "mission_01.wav" },
    { "text": "挑戦を受け入れるかしないかはあなた次第。",     "voice": "mission_02.wav" },
    { "text": "この使命、受け取ってみて。",                   "voice": "mission_03.wav" },
    { "text": "宇宙があなたに試練を送ってきたわ。",           "voice": "mission_04.wav" },
    { "text": "困難は成長のギフトよ。",                       "voice": "mission_05.wav" }
  ],
  "levelup": [
    { "text": "レベルアップしました！意識が高まったわ。",     "voice": "levelup_01.wav" },
    { "text": "素晴らしいわ。",                               "voice": "levelup_02.wav" },
    { "text": "あなたの世界線が広がったわ。",                 "voice": "levelup_03.wav" },
    { "text": "新しい扉が開いたわ。",                         "voice": "levelup_04.wav" },
    { "text": "進化のときよ…おめでとう。",                   "voice": "levelup_05.wav" },
    { "text": "あなたの意識が宇宙と共鳴し始めたわ。",         "voice": "levelup_06.wav" }
  ],
  "rare": [
    { "text": "珍しいことが起きているわ…宇宙があなたに特別なものを届けて…", "voice": "rare_01.wav" },
    { "text": "これはレアな世界線…大切にしてね。",                         "voice": "rare_02.wav" },
    { "text": "あなたの引き寄せ力が高まっている証拠よ。",                   "voice": "rare_03.wav" }
  ],
  "legendary": [
    { "text": "これは伝説よ。",                                               "voice": "legendary_01.wav" },
    { "text": "こんな世界線に辿り着けるのは…あなたが特別だからよ。",         "voice": "legendary_02.wav" },
    { "text": "この瞬間を忘れないで。",                                       "voice": "legendary_03.wav" },
    { "text": "宇宙の奇跡があなたのもとへ降りてきた。",                       "voice": "legendary_04.wav" },
    { "text": "伝説の扉が開いたわ。",                                         "voice": "legendary_05.wav" }
  ],
  "ending": [
    { "text": "また来て、続きを紡いでね。",         "voice": "ending_01.wav" },
    { "text": "また明日ね。",                       "voice": "ending_02.wav" },
    { "text": "よく来てくれたわ。",                 "voice": "ending_03.wav" },
    { "text": "いつでも戻っておいで。",             "voice": "ending_04.wav" },
    { "text": "これで一つの旅は終わり。",           "voice": "ending_05.wav" },
    { "text": "今日の選択は宇宙に刻まれたわ。",     "voice": "ending_06.wav" },
    { "text": "今日の旅、お疲れ様。",               "voice": "ending_07.wav" },
    { "text": "扉はいつも開いているわ。",           "voice": "ending_08.wav" }
  ],
  "idle": [
    { "text": "…まだそこにいるの？",                               "voice": "idle_01.wav" },
    { "text": "心の声を聞いてみて。",                               "voice": "idle_02.wav" },
    { "text": "宇宙はあなたを待っているから。",                     "voice": "idle_03.wav" },
    { "text": "急がなくていいわ。",                                 "voice": "idle_04.wav" }
  ],
  "noEvent": [
    { "text": "今日はイベントがないわ。でも、それも意味があるのよ。", "voice": "noEvent_01.wav" },
    { "text": "静かな日も大切ね。ただ在るだけでいいの。",             "voice": "noEvent_02.wav" },
    { "text": "宇宙が休息を勧めているのかもしれないわ。",             "voice": "noEvent_03.wav" }
  ]
}
